;;; ============================================================================
;;;  Экспертная система диагностики неисправностей НКУ / шкафов управления
;;;  Кейс-задача №3. Оболочка: CLIPS 6.4 (прямой вывод, алгоритм Rete).
;;;
;;;  Запуск:
;;;     (load "expert_system_nku.clp")
;;;     (reset)
;;;     (run)
;;;  Отвечайте на вопросы одним из предложенных вариантов (например, да / нет).
;;; ============================================================================

;;; --------- Шаблоны (структура базы знаний) ---------
(deftemplate признак
   (slot имя)        ; вход, выход, автомат, двигатель, тепзащита, контактор, ложные
   (slot значение))  ; да / нет

(deftemplate диагноз
   (slot правило)
   (slot причина)
   (slot рекомендация)
   (slot cf))         ; коэффициент достоверности 0..1

;;; --------- Функция диалога: задать вопрос и проверить ответ ---------
(deffunction спросить (?вопрос $?варианты)
   (printout t ?вопрос " ")
   (bind ?ответ (read))
   (while (not (member$ ?ответ ?варианты)) do
      (printout t "   допустимые ответы (" (implode$ ?варианты) "): ")
      (bind ?ответ (read)))
   (return ?ответ))

;;; --------- Приветствие ---------
(defrule старт
   (declare (salience 120))
   (initial-fact)
   =>
   (printout t crlf "=== Экспертная система диагностики неисправностей НКУ ===" crlf)
   (printout t "Ответьте на несколько вопросов о симптомах." crlf crlf))

;;; ============================================================================
;;;  Правила-вопросы (управляемый данными опрос: спрашиваем только нужное)
;;; ============================================================================
(defrule q-вход
   (declare (salience 100))
   (not (признак (имя вход)))
   =>
   (assert (признак (имя вход)
      (значение (спросить "Есть ли напряжение на входе шкафа? (да/нет)" да нет)))))

(defrule q-выход
   (declare (salience 95))
   (признак (имя вход) (значение да))
   (not (признак (имя выход)))
   =>
   (assert (признак (имя выход)
      (значение (спросить "Появляется ли напряжение на выходе? (да/нет)" да нет)))))

(defrule q-автомат
   (declare (salience 90))
   (признак (имя выход) (значение нет))
   (not (признак (имя автомат)))
   =>
   (assert (признак (имя автомат)
      (значение (спросить "Срабатывает ли автоматический выключатель при пуске? (да/нет)" да нет)))))

(defrule q-двигатель
   (declare (salience 90))
   (признак (имя выход) (значение да))
   (not (признак (имя двигатель)))
   =>
   (assert (признак (имя двигатель)
      (значение (спросить "Запускается ли двигатель нагрузки? (да/нет)" да нет)))))

(defrule q-тепзащита
   (declare (salience 85))
   (признак (имя двигатель) (значение нет))
   (not (признак (имя тепзащита)))
   =>
   (assert (признак (имя тепзащита)
      (значение (спросить "Сработала ли тепловая защита двигателя? (да/нет)" да нет)))))

(defrule q-контактор
   (declare (salience 80))
   (признак (имя двигатель))
   (not (признак (имя контактор)))
   =>
   (assert (признак (имя контактор)
      (значение (спросить "Гудит и перегревается ли контактор? (да/нет)" да нет)))))

(defrule q-ложные
   (declare (salience 75))
   (признак (имя контактор) (значение нет))
   (not (признак (имя ложные)))
   =>
   (assert (признак (имя ложные)
      (значение (спросить "Бывают ли ложные срабатывания защиты? (да/нет)" да нет)))))

;;; ============================================================================
;;;  Диагностические правила (база правил R-01 … R-06)
;;; ============================================================================
(defrule R-01
   (признак (имя вход) (значение нет))
   =>
   (assert (диагноз (правило "R-01")
      (причина "Отсутствие входного питания (обрыв ввода)")
      (рекомендация "Проверить вводной автомат и питающую линию")
      (cf 0.90))))

(defrule R-02
   (признак (имя вход) (значение да))
   (признак (имя выход) (значение нет))
   (признак (имя автомат) (значение нет))
   =>
   (assert (диагноз (правило "R-02")
      (причина "Обрыв цепи управления или неисправность контактора")
      (рекомендация "Проверить цепь управления, катушку и контакты контактора")
      (cf 0.70))))

(defrule R-03
   (признак (имя вход) (значение да))
   (признак (имя выход) (значение нет))
   (признак (имя автомат) (значение да))
   =>
   (assert (диагноз (правило "R-03")
      (причина "Короткое замыкание в силовой цепи нагрузки")
      (рекомендация "Проверить кабельную линию и клеммы нагрузки, изоляцию")
      (cf 0.85))))

(defrule R-04
   (признак (имя контактор) (значение да))
   =>
   (assert (диагноз (правило "R-04")
      (причина "Подгорание контактов или межвитковое замыкание катушки контактора")
      (рекомендация "Осмотреть и при необходимости заменить контактор")
      (cf 0.75))))

(defrule R-05
   (признак (имя двигатель) (значение нет))
   (признак (имя тепзащита) (значение да))
   =>
   (assert (диагноз (правило "R-05")
      (причина "Перегрузка двигателя или заклинивание механизма")
      (рекомендация "Проверить нагрузку и механику привода, ток двигателя")
      (cf 0.80))))

(defrule R-06
   (признак (имя ложные) (значение да))
   =>
   (assert (диагноз (правило "R-06")
      (причина "Некорректная уставка защиты или плохой контакт в цепи")
      (рекомендация "Проверить уставки защиты и качество контактных соединений")
      (cf 0.65))))

;;; ============================================================================
;;;  Вывод результата и объяснение
;;; ============================================================================
(defrule показать-диагноз
   (declare (salience -100))
   (диагноз (правило ?rid) (причина ?p) (рекомендация ?r) (cf ?c))
   =>
   (printout t crlf "---- Заключение -------------------------------------------" crlf)
   (printout t "Вероятная причина: " ?p crlf)
   (printout t "Достоверность (CF): " ?c crlf)
   (printout t "Рекомендация:      " ?r crlf)
   (printout t "Пояснение:         сработало правило " ?rid crlf))

(defrule нет-диагноза
   (declare (salience -200))
   (not (диагноз))
   =>
   (printout t crlf "Однозначная причина не определена по имеющимся признакам —"
             crlf "требуется осмотр специалиста." crlf))
